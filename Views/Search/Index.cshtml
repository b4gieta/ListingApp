@model List<ListingApp.ViewModels.ListingListItemViewModel>

@{
    if (ViewBag.Query != null)
    {
        ViewData["Title"] = $"Wyniki wyszukiwania dla \"{ViewBag.Query}\"";
    }
    else
    {
        ViewData["Title"] = "Wyszukiwanie ogłoszeń";
    }
}

<div class="container mt-4">

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <form method="get"
                  asp-controller="Search"
                  asp-action="Index">

                <div class="row g-3">

                    <div class="col-12">

                        <div class="input-group">

                            <input type="text"
                                   name="query"
                                   value="@ViewBag.Query"
                                   class="form-control"
                                   placeholder="Wpisz tytuł ogłoszenia..." />

                            <button type="submit"
                                    class="btn btn-primary">
                                Szukaj
                            </button>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <select name="categoryId"
                                class="form-select">

                            <option value="">
                                Wszystkie kategorie
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Value"
                                        selected="@(ViewBag.CategoryId?.ToString() == category.Value)">
                                    @category.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <input type="number"
                               step="0.01"
                               min="0"
                               name="minPrice"
                               value="@ViewBag.MinPrice"
                               class="form-control"
                               placeholder="Cena od" />

                    </div>

                    <div class="col-md-3">

                        <input type="number"
                               step="0.01"
                               min="0"
                               name="maxPrice"
                               value="@ViewBag.MaxPrice"
                               class="form-control"
                               placeholder="Cena do" />

                    </div>

                    <div class="col-md-3">

                        <select name="sort"
                                class="form-select">

                            <option value=""
                                    selected="@(string.IsNullOrEmpty(ViewBag.Sort as string))">
                                Najnowsze
                            </option>

                            <option value="date_asc"
                                    selected="@(ViewBag.Sort == "date_asc")">
                                Najstarsze
                            </option>

                            <option value="price_asc"
                                    selected="@(ViewBag.Sort == "price_asc")">
                                Cena rosnąco
                            </option>

                            <option value="price_desc"
                                    selected="@(ViewBag.Sort == "price_desc")">
                                Cena malejąco
                            </option>

                        </select>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (ViewBag.Query != null)
    {
        <h1 class="h4 mb-3">
            Wyniki dla "@ViewBag.Query"
        </h1>
    }
    else
    {
        <h1 class="h4 mb-3">
            Wyniki wyszukiwania
        </h1>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            Nie znaleziono ogłoszeń.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var listing in Model)
            {
                <div class="col">

                    <a asp-controller="Listing"
                       asp-action="Details"
                       asp-route-id="@listing.Id"
                       class="text-decoration-none text-dark">

                        <div class="card h-100 border-0 shadow-sm">

                            @if (!string.IsNullOrEmpty(listing.ImageFileName))
                            {
                                <img src="~/uploads/@listing.ImageFileName"
                                     class="card-img-top"
                                     style="height:200px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="height:200px;">
                                    <span class="text-muted">Brak zdjęcia</span>
                                </div>
                            }

                            <div class="card-body">

                                <h5 class="card-title">
                                    @listing.Title
                                </h5>

                                <div class="fw-bold text-primary mb-2">
                                    @listing.Price zł
                                </div>

                                <div class="text-muted small">
                                    @listing.Location
                                </div>

                                <div class="text-muted small">
                                    @listing.CategoryName
                                </div>

                                <div class="text-muted small mt-2">
                                    @listing.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>

                            </div>

                        </div>

                    </a>

                </div>
            }

        </div>
    }

</div>