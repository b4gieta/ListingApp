@model ListingApp.ViewModels.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                @if (Model.ExistingImages.Any())
                {
                    <div id="lightgallery">

                        <a href="~/uploads/@Model.ExistingImages[0].FileName"
                           data-src="@Url.Content("~/uploads/" + Model.ExistingImages[0].FileName)">
                            <img src="~/uploads/@Model.ExistingImages[0].FileName"
                                 class="card-img-top mb-3"
                                 style="max-height:500px; object-fit:cover;" />
                        </a>

                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var img in Model.ExistingImages.Skip(1))
                            {
                                <a href="~/uploads/@img.FileName"
                                   data-src="@Url.Content("~/uploads/" + img.FileName)">
                                    <img src="~/uploads/@img.FileName"
                                         style="width:100px; height:100px; object-fit:cover; cursor:pointer;"
                                         class="border rounded" />
                                </a>
                            }

                        </div>

                    </div>
                }

                <div class="card-body">

                    <h1 class="h3 mb-3">
                        @Model.Title
                    </h1>

                    <h2 class="h4 fw-bold mb-4">
                        @Model.Price zł
                    </h2>

                    <div class="border-top pt-4">

                        <h3 class="h5 mb-3">
                            Opis
                        </h3>

                        <p class="mb-0" style="white-space:pre-line;">
                            @Model.Description
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm mb-3">

                <div class="card-body">

                    <h3 class="h5 mb-4">
                        Szczegóły
                    </h3>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Lokalizacja
                        </div>

                        <div>
                            @Model.Location
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Kategoria
                        </div>

                        <div>
                            @Model.CategoryName
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small">
                            Autor ogłoszenia
                        </div>

                        <div>
                            @Model.Username
                        </div>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Data dodania
                        </div>

                        <div>
                            @Model.CreatedAt.ToLocalTime().ToString("HH:mm dd.MM.yyyy")
                        </div>
                    </div>

                </div>

            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-grid gap-2">

                        <a asp-controller="Listing"
                           asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            Edytuj
                        </a>

                        <form asp-controller="Listing"
                              asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger w-100">
                                Usuń
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/css/lightgallery-bundle.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/lightgallery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/thumbnail/lg-thumbnail.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/zoom/lg-zoom.min.js"></script>

    <script>
                lightGallery(document.getElementById('lightgallery'), {
            plugins: [lgThumbnail, lgZoom],
            speed: 500,
            selector: 'a'
        });
    </script>
}