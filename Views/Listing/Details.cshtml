@model ListingApp.ViewModels.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

<p>@Model.Description</p>

<p><strong>Cena:</strong> @Model.Price zł</p>

<p><strong>Lokalizacja:</strong> @Model.Location</p>

<p><strong>Kategoria:</strong> @Model.CategoryName</p>

<p><strong>Autor ogłoszenia:</strong> @Model.Username</p>

<p><strong>Data dodania:</strong> @Model.CreatedAt.ToLocalTime().ToString("HH:mm dd.MM.yyyy")</p>

@if (!string.IsNullOrEmpty(Model.ImageFileName))
{
    <img src="~/uploads/@Model.ImageFileName" width="300" />
}

<div class="mt-3">

    <a asp-controller="Listing"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edytuj
    </a>

    <form asp-controller="Listing"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          style="display:inline;">

        <button type="submit" class="btn btn-danger">
            Usuń
        </button>

    </form>

</div>