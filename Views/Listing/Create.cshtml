@model ListingApp.ViewModels.ListingViewModel

@{
    ViewData["Title"] = "Dodaj ogłoszenie";
}

<h1>Dodaj ogłoszenie</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Title">Nazwa</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description">Opis</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price">Cena</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Location">Lokalizacja</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId">Kategoria</label>

        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-control">
        </select>

        <span asp-validation-for="CategoryId"></span>
    </div>

    <div class="mb-3">

        <label>Zdjęcia</label>

        <input id="imageInput"
               asp-for="Images"
               type="file"
               multiple
               accept="image/*"
               class="form-control" />

        <span asp-validation-for="Images"></span>

    </div>

    <div id="imagePreviewContainer"></div>

    <button type="submit" class="btn btn-primary">
        Dodaj
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const previewContainer = document.getElementById("imagePreviewContainer");

        let selectedFiles = [];

        imageInput.addEventListener("change", function (e)
        {
            const files = Array.from(e.target.files);

            for (const file of files)
            {
                if (selectedFiles.length >= 8)
                {
                    alert("Maksymalnie 8 zdjęć.");
                    break;
                }

                selectedFiles.push(file);
                addImagePreview(file); // dodajemy od razu tylko nowe
            }

            syncInputFiles();
        });

        function addImagePreview(file)
        {
            const reader = new FileReader();

            reader.onload = function (e)
            {
                const wrapper = document.createElement("div");
                wrapper.style.marginBottom = "10px";

                const img = document.createElement("img");
                img.src = e.target.result;
                img.width = 200;

                const btn = document.createElement("button");
                btn.type = "button";
                btn.textContent = "Usuń";

                btn.addEventListener("click", function ()
                {
                    // usuń z tablicy
                    selectedFiles = selectedFiles.filter(f => f !== file);

                    // usuń tylko ten element z DOM (bez refreshPreview)
                    wrapper.remove();

                    syncInputFiles();
                });

                wrapper.appendChild(img);
                wrapper.appendChild(document.createElement("br"));
                wrapper.appendChild(btn);

                previewContainer.appendChild(wrapper);
            };

            reader.readAsDataURL(file);
        }

        function syncInputFiles()
        {
            const dataTransfer = new DataTransfer();

            selectedFiles.forEach(file =>
            {
                dataTransfer.items.add(file);
            });

            imageInput.files = dataTransfer.files;
        }
    </script>
}