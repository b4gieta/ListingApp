@model ListingApp.ViewModels.ListingFormViewModel

@{
    ViewData["Title"] = "Dodaj ogłoszenie";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h1 class="h3 mb-4">
                        Dodaj ogłoszenie
                    </h1>

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                                Nazwa
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Opis
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="6"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>

                        </div>

                        <div class="row">

                            <div class="col-md-6">

                                <div class="mb-4">

                                    <label asp-for="Price"
                                           class="form-label fw-semibold">
                                        Cena
                                    </label>

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           class="form-control" />

                                    <span asp-validation-for="Price"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="mb-4">

                                    <label asp-for="CategoryId"
                                           class="form-label fw-semibold">
                                        Kategoria
                                    </label>

                                    <select asp-for="CategoryId"
                                            asp-items="Model.Categories"
                                            class="form-select">
                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Location"
                                   class="form-label fw-semibold">
                                Lokalizacja
                            </label>

                            <input asp-for="Location"
                                   class="form-control" />

                            <span asp-validation-for="Location"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="NewImages"
                                   class="form-label fw-semibold">
                                Zdjęcia
                            </label>

                            <input asp-for="NewImages"
                                   type="file"
                                   accept="image/*"
                                   multiple
                                   class="form-control"
                                   id="imageInput" />

                        </div>

                        <div id="imagePreviewContainer"
                             class="row g-3">
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg">
                            Dodaj ogłoszenie
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const container = document.getElementById("imagePreviewContainer");

        imageInput.addEventListener("change", function ()
        {
            container.innerHTML = "";

            for (const file of this.files)
            {
                const reader = new FileReader();

                reader.onload = function (e)
                {
                    const col = document.createElement("div");
                    col.className = "col-md-4";

                    col.innerHTML = `
                        <img src="${e.target.result}"
                             class="img-fluid rounded border" />
                    `;

                    container.appendChild(col);
                };

                reader.readAsDataURL(file);
            }
        });
    </script>
}