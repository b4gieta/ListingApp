@model ListingApp.ViewModels.ListingFormViewModel

@{
    ViewData["Title"] = "Edytuj " + Model.Title;
}

<h1>Edytuj ogłoszenie</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Title">Nazwa</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description">Opis</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price">Cena</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Location">Lokalizacja</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId">Kategoria</label>

        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-control">
        </select>

        <span asp-validation-for="CategoryId"></span>
    </div>

    <div class="mb-3">

        <label asp-for="Image" class="form-label">
            Zdjęcie
        </label>

        <input asp-for="Image"
               type="file"
               accept="image/*"
               class="form-control"
               id="imageInput" />

    </div>

    <div class="mb-3">

        <img id="imagePreview"
             src="@(Model.ExistingImage != null ? Url.Content("~/uploads/" + Model.ExistingImage) : "")"
             width="200"
             style="@(Model.ExistingImage != null ? "" : "display:none;")" />

    </div>

    <button type="submit" class="btn btn-primary">
        Edytuj
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");

        imageInput.addEventListener("change", function ()
        {
            const file = this.files[0];

            if (!file)
            {
                imagePreview.style.display = "none";
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e)
            {
                imagePreview.src = e.target.result;
                imagePreview.style.display = "block";
            };

            reader.readAsDataURL(file);
        });
    </script>
}