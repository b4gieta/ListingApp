@model ListingApp.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "Twój profil";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h1 class="h3 mb-0">
                            Twój profil
                        </h1>

                        <button type="button"
                                class="btn btn-outline-primary"
                                onclick="toggleEdit()">
                            Edytuj profil
                        </button>

                    </div>

                    <form asp-action="Profile" method="post">

                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">

                            <label class="form-label">
                                Login
                            </label>

                            <input asp-for="Login"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   id="Email"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Imię
                                </label>

                                <input asp-for="FirstName"
                                       id="FirstName"
                                       class="form-control"
                                       disabled />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Nazwisko
                                </label>

                                <input asp-for="LastName"
                                       id="LastName"
                                       class="form-control"
                                       disabled />

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Telefon
                            </label>

                            <input asp-for="TelephoneNumber"
                                   id="TelephoneNumber"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Lokalizacja
                            </label>

                            <input asp-for="Location"
                                   id="Location"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    id="saveBtn"
                                    class="btn btn-primary"
                                    style="display:none;">
                                Zapisz zmiany
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    let editMode = false;

    function toggleEdit() {
        editMode = !editMode;

        const fields = [
            "Email",
            "FirstName",
            "LastName",
            "TelephoneNumber",
            "Location"
        ];

        fields.forEach(id => {
            document.getElementById(id).disabled = !editMode;
        });

        document.getElementById("saveBtn").style.display =
            editMode ? "block" : "none";
    }
</script>