@model ListingApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Logowanie";
}

<h2>Logowanie / Rejestracja</h2>

<button type="button" onclick="showLogin()">Zaloguj</button>
<button type="button" onclick="showRegister()">Zarejestruj</button>

<hr />

@if (!ViewData.ModelState.IsValid)
{
    <div style="color:red">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<!-- LOGIN -->
<div id="loginBox">

    <form asp-action="Login" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Login" placeholder="Login" />
        <span asp-validation-for="Login" class="text-danger"></span>

        <input asp-for="Password" type="password" placeholder="Hasło" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <button type="submit">Zaloguj</button>

    </form>

</div>

<!-- REGISTER -->
<div id="registerBox" style="display:none">

    <form asp-action="Register" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input name="Login" placeholder="Login" />
        <span class="text-danger" data-valmsg-for="Login"></span>

        <input name="Email" placeholder="Email" />
        <span class="text-danger" data-valmsg-for="Email"></span>

        <input name="FirstName" placeholder="Imię" />
        <span class="text-danger" data-valmsg-for="FirstName"></span>

        <input name="LastName" placeholder="Nazwisko" />
        <span class="text-danger" data-valmsg-for="LastName"></span>

        <input name="TelephoneNumber" placeholder="Numer telefonu" />
        <span class="text-danger" data-valmsg-for="TelephoneNumber"></span>

        <input name="Location" placeholder="Lokalizacja" />
        <span class="text-danger" data-valmsg-for="Location"></span>

        <input name="Password" type="password" placeholder="Hasło" />
        <span class="text-danger" data-valmsg-for="Password"></span>

        <input name="ConfirmPassword" type="password" placeholder="Powtórz hasło" />
        <span class="text-danger" data-valmsg-for="ConfirmPassword"></span>

        <button type="submit">Zarejestruj</button>

    </form>

</div>

<script>
    function showLogin() {
        document.getElementById("loginBox").style.display = "block";
        document.getElementById("registerBox").style.display = "none";
    }

    function showRegister() {
        document.getElementById("loginBox").style.display = "none";
        document.getElementById("registerBox").style.display = "block";
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}