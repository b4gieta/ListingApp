@model List<ListingApp.ViewModels.ListingListItemViewModel>

<h1>Ogłoszenia</h1>

<a asp-controller="Listing" asp-action="Create" class="btn btn-primary mb-3">
    Dodaj ogłoszenie
</a>

@foreach (var listing in Model)
{
    <div style="border:1px solid gray; padding:15px; margin-bottom:15px;">

        <a asp-controller="Listing"
           asp-action="Details"
           asp-route-id="@listing.Id">
            @listing.Title
        </a>

        <p>@listing.Description</p>

        <p>
            <strong>Cena:</strong>
            @listing.Price zł
        </p>

        <p>
            <strong>Lokalizacja:</strong>
            @listing.Location
        </p>

        <p>
            <strong>Kategoria:</strong>
            @listing.CategoryName
        </p>

        <p>
            <strong>Autor:</strong>
            @listing.Username
        </p>

        <p>
            <strong>Dodano:</strong>
            @listing.CreatedAt
        </p>

        <div class="mt-3">

            <a asp-controller="Listing"
               asp-action="Edit"
               asp-route-id="@listing.Id"
               class="btn btn-warning">
                Edytuj
            </a>

            <form asp-controller="Listing"
                  asp-action="Delete"
                  asp-route-id="@listing.Id"
                  method="post"
                  style="display:inline;">

                <button type="submit" class="btn btn-danger">
                    Usuń
                </button>

            </form>

        </div>

    </div>
}