@model List<ListingApp.ViewModels.ListingListItemViewModel>

@{
    ViewData["Title"] = "Strona główna";
}

<form method="get" asp-controller="Search" asp-action="Index" class="mb-4">

    <div class="input-group">

        <input type="text"
               name="query"
               value="@ViewBag.Query"
               class="form-control"
               placeholder="Wpisz tytuł ogłoszenia..." />

        <button type="submit" class="btn btn-primary">
            Szukaj
        </button>

    </div>

</form>

<h1>Najnowsze ogłoszenia</h1>

<div class="listing-grid">

    @foreach (var listing in Model)
    {
        <div>

            <a asp-controller="Listing"
               asp-action="Details"
               asp-route-id="@listing.Id"
               class="listing-card">

                <div class="listing-title">
                    @listing.Title
                </div>

                <div class="listing-price">
                    @listing.Price zł
                </div>

                <div class="listing-info">
                    @listing.Location
                </div>

                <div class="listing-info">
                    @listing.CategoryName
                </div>

                <div class="listing-info">
                    Dodano @listing.CreatedAt.ToLocalTime().ToString("HH:mm dd.MM.yyyy ")
                </div>

            </a>

        </div>
    }

</div>